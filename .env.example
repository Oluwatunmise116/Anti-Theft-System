# Copy this file to .env and fill in real values — or, if .env already
# exists, add the lines you need to it. NEVER commit the real .env (it is
# git-ignored). Every value below is a placeholder.
#
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Application ──────────────────────────────────────────────────────────────
# production (default) | development | test
APP_ENV=production
# Signs the staff session cookie. Required in production (32+ characters).
FLASK_SECRET_KEY=replace-with-64-hex-characters
# Set to 1 only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=0
# Optional: database location (default license.db in the project folder).
# LICENSE_DB_PATH=license.db

# ── SMS OTP fallback (Robase — https://docs.robase.dev) ──────────────────────
# live: real SMS. Every send spends Robase credits and goes to a real phone;
#       Robase has no test mode.
# mock: DEVELOPMENT ONLY — nothing is sent; codes are written to
#       instance/sms_mock_outbox.jsonl. Refused unless APP_ENV=development.
SMS_DELIVERY_MODE=live
# API key from https://robase.dev/app/api-keys (starts with robe_). Used only
# by the Flask server; it is never sent to the browser or written to logs.
ROBASE_API_KEY=robe_replace-with-your-robase-api-key
# Optional: en | fr for the SMS text (default: the Robase workspace language).
# ROBASE_SMS_LANGUAGE=en
# Optional: HTTP timeouts in seconds (defaults shown).
# ROBASE_CONNECT_TIMEOUT=5
# ROBASE_READ_TIMEOUT=10
# ROBASE_BASE_URL=https://api.robase.dev

# ── Phone numbers ────────────────────────────────────────────────────────────
# Region used to read numbers saved without a country code (0803… -> +234803…).
PHONE_DEFAULT_REGION=NG

# ── Optional tuning (defaults shown; values are clamped to safe ranges) ──────
# OTP_LENGTH=6
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=3
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS_PER_TRIP=5
# OTP_MAX_FAILED_PER_TRIP=6
# OTP_HOLDER_WINDOW_SECONDS=3600
# OTP_MAX_SENDS_PER_HOLDER_WINDOW=10
# OTP_MAX_FAILED_PER_HOLDER_WINDOW=10
# EXIT_AUTHORIZATION_TTL_SECONDS=120
# PASSCODE_MIN_LENGTH=4
# PASSCODE_MAX_LENGTH=8
# PASSCODE_MAX_ATTEMPTS=5
# STAFF_SESSION_HOURS=12

# ── Dataset download (scripts/download_nigerian_plate_dataset.py only) ───────
# Get your key from https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=replace-with-your-roboflow-key
ROBOFLOW_WORKSPACE=your-workspace-slug
ROBOFLOW_PROJECT=nigerian-license-plate
# Leave blank to auto-select the latest published version.
ROBOFLOW_VERSION=
