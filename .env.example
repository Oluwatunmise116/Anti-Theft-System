# Copy this file to .env and fill in real values. NEVER commit the real
# .env file — it is already excluded via .gitignore. Nothing in this repo
# reads these values from source code; scripts/download_nigerian_plate_dataset.py
# reads them from the environment (optionally loaded from a local .env).

# Get your key from https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=ERwT8Ry5EwDp8Fh8d3ym

# The Roboflow workspace slug that owns your copy of the dataset. If you
# don't have direct access to the "nigerianlpd" workspace, fork the project
# into your own workspace first (see the MANUAL STEP printed by
# scripts/download_nigerian_plate_dataset.py) and put YOUR workspace slug
# here.
ROBOFLOW_WORKSPACE=oluwatunmise-olabanji

# Roboflow project slug — defaults to nigerian-license-plate if left blank.
ROBOFLOW_PROJECT=nigerian-license-plate

# Specific dataset version number to download. Leave blank to auto-select
# the latest published version (recommended — the download script inspects
# and validates whichever version it selects).
ROBOFLOW_VERSION=
